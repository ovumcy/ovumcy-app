{
  "expo": {
    "scheme": "ovumcy",
    "plugins": [
      "expo-router",
      "@react-native-community/datetimepicker",
      "expo-notifications",
      "expo-sqlite",
      "expo-secure-store"
    ],
    "icon": "./assets/branding/ovumcy-icon-512.png",
    "splash": {
      "image": "./assets/branding/ovumcy-splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#f7f0e6"
    },
    "version": "1.0.0",
    "android": {
      "package": "cloud.ovumcy.app",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/branding/ovumcy-icon-512-maskable.png",
        "backgroundColor": "#f7f0e6"
      }
    },
    "web": {
      "favicon": "./assets/branding/ovumcy-icon-192.png"
    },
    "name": "Ovumcy",
    "slug": "ovumcy-app"
  }
}
