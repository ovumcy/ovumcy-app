{
  "$schema": "https://unpkg.com/knip@6.24.0/schema.json",
  "entry": [
    "app/**/*.tsx",
    "plugins/*.js",
    "jest.config.js",
    "jest.setup.ts",
    "babel.config.js",
    "e2e/**/*.spec.ts",
    "scripts/*.mjs",
    "src/**/*.test.{ts,tsx}",
    "src/test/**/*.{ts,tsx}"
  ],
  "project": [
    "app/**/*.{ts,tsx}",
    "src/**/*.{ts,tsx}",
    "plugins/*.js",
    "scripts/*.mjs",
    "e2e/**/*.ts",
    "*.{js,ts,mjs,cjs}"
  ],
  "ignore": [
    "dist/**",
    "android/**",
    ".expo/**",
    "src/**/*.native.ts",
    "src/**/*.web.ts"
  ],
  "ignoreExportsUsedInFile": true,
  "ignoreDependencies": [
    "babel-preset-expo",
    "expo-updates"
  ]
}
